# DoingsMachine Backend — Environment Variables
# Copy this to .env and fill in values

PORT=4000

# XRPL Testnet WebSocket
XRPL_WSS=wss://s.altnet.rippletest.net:51233

# Event wallet — the funded testnet address that receives all sprays.
# Generate one at: https://faucet.altnet.rippletest.net/accounts
EVENT_WALLET_ADDRESS=$ilp.interledger-test.dev/praisee

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Fee percentage (e.g. 1.5 = 1.5%)
PLATFORM_FEE_PCT=1.5
